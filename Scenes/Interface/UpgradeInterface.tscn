[sub_resource type="GDScript" id="GDScript_xfjfj"]
script/source = "class_name UpgradeUIAnimation
extends Node

@export var upgrade_ui: Control         
@export var card_1: Button
@export var card_2: Button
@export var card_3: Button

@export_category(\"Animation Settings\")
@export var popup_duration: float = 0.5
@export var card_stagger: float = 0.08   ## delay between each card appearing
@export var overshoot_scale: Vector2 = Vector2(1.08, 1.08)
@export var background_fade_duration: float = 0.3

@export var background_panel: Panel      

var tween: Tween


func play_popup() -> void:
	self.visible = true
	background_panel.visible = true
	_disable_cards(true)

	## Start everything invisible
	if background_panel:
		background_panel.modulate.a = 0.0

	var card_offset := Vector2(0, 40)
	card_1.scale = Vector2.ZERO
	card_2.scale = Vector2.ZERO
	card_3.scale = Vector2.ZERO
	card_1.modulate.a = 0.0
	card_2.modulate.a = 0.0
	card_3.modulate.a = 0.0
	card_1.position += card_offset
	card_2.position += card_offset
	card_3.position += card_offset

	var card_1_origin := card_1.position - card_offset
	var card_2_origin := card_2.position - card_offset
	var card_3_origin := card_3.position - card_offset

	if tween:
		tween.kill()
	tween = create_tween()
	tween.set_parallel(true)

	## Background fades in
	if background_panel:
		tween.tween_property(background_panel, \"modulate:a\", 1, 0.35)\\
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)

	## Card 1
	tween.tween_property(card_1, \"scale\", Vector2.ONE, 0.45)\\
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	tween.tween_property(card_1, \"modulate:a\", 1.0, 0.3)\\
		.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	tween.tween_property(card_1, \"position\", card_1_origin, 0.45)\\
		.set_trans(Tween.TRANS_QUART).set_ease(Tween.EASE_OUT)

	## Card 2 — staggered
	tween.tween_property(card_2, \"scale\", Vector2.ONE, 0.45)\\
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)\\
		.set_delay(card_stagger)
	tween.tween_property(card_2, \"modulate:a\", 1.0, 0.3)\\
		.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)\\
		.set_delay(card_stagger)
	tween.tween_property(card_2, \"position\", card_2_origin, 0.45)\\
		.set_trans(Tween.TRANS_QUART).set_ease(Tween.EASE_OUT)\\
		.set_delay(card_stagger)

	## Card 3 — more staggered
	tween.tween_property(card_3, \"scale\", Vector2.ONE, 0.45)\\
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)\\
		.set_delay(card_stagger * 2)
	tween.tween_property(card_3, \"modulate:a\", 1.0, 0.3)\\
		.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)\\
		.set_delay(card_stagger * 2)
	tween.tween_property(card_3, \"position\", card_3_origin, 0.45)\\
		.set_trans(Tween.TRANS_QUART).set_ease(Tween.EASE_OUT)\\
		.set_delay(card_stagger * 2)

	await tween.finished
	_disable_cards(false)


func play_dismiss(picked_index: int) -> void:
	_disable_cards(true)

	if tween:
		tween.kill()
	tween = create_tween()
	tween.set_parallel(true)

	var cards := [card_1, card_2, card_3]
	for i in range(cards.size()):
		if i == picked_index:
			## Picked card scales up briefly then fades out smoothly
			tween.tween_property(cards[i], \"scale\", Vector2(1.15, 1.15), 0.1)\\
				.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
			tween.tween_property(cards[i], \"scale\", Vector2.ZERO, 0.25)\\
				.set_trans(Tween.TRANS_QUART).set_ease(Tween.EASE_IN)\\
				.set_delay(0.1)
			tween.tween_property(cards[i], \"modulate:a\", 0.0, 0.3)\\
				.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)\\
				.set_delay(0.05)
		else:
			## Unchosen cards slide down and fade smoothly
			tween.tween_property(cards[i], \"scale\", Vector2(0.85, 0.85), 0.15)\\
				.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)\\
				.set_delay(randf_range(0.0, 0.04))
			tween.tween_property(cards[i], \"scale\", Vector2.ZERO, 0.2)\\
				.set_trans(Tween.TRANS_QUART).set_ease(Tween.EASE_IN)\\
				.set_delay(0.15)
			tween.tween_property(cards[i], \"modulate:a\", 0.0, 0.25)\\
				.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)\\
				.set_delay(randf_range(0.0, 0.04))

	if background_panel:
		tween.tween_property(background_panel, \"modulate:a\", 0.0, 0.3)\\
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)\\
			.set_delay(0.1)
	self.visible = false
	background_panel.visible = false
	await tween.finished


func _disable_cards(disabled: bool) -> void:
	card_1.disabled = disabled
	card_2.disabled = disabled
	card_3.disabled = disabled
"

